	(text "Hot loop"
		(exclude_from_sim no)
		(at 275.59 62.865 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0733952e-91d5-41a5-a467-2b7b6bd5e1c8")
	)
	(text "AP63356, 12V -> 3.3V, 450kHz fixed PWM (no light-load skipping)\n\nVout = 0.8V ref * (1 + R9/R10) = 0.8 * (1 + 75k/24k) = 3.300V exact\n\nFeedforward cap C30: zero at 1/(2*pi*75k*47pF) = 45kHz\n  (datasheet ref 91k/33pF = 53kHz, close enough, loop unaffected)\n\nInductor L3 = 4.7uH (datasheet Table 1 value, do not change, internal comp)\nRipple current: dIL = 3.3 * (1 - 3.3/12) / (4.7u * 450k) = 1.13A peak-peak\ninductor peak = load + half ripple = 0.5 + 0.57 = ~1.1A\n\nOutput ripple: 1.13A / (8 * 450k * 30uF effective) = ~10mV peak-peak\n(30uF = 2x22uF derated for DC bias)\n\nLoad: ~150mA idle, ~500mA burst (ESP32-C3 WiFi), always CCM"
		(exclude_from_sim no)
		(at 30.48 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "327df667-d8dd-4480-9a8f-727813375bfb")
	)
	(text "use inductors YSPI0520-4R7M and YSPI0520-6R8M"
		(exclude_from_sim no)
		(at 119.38 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5d5c40f0-0919-4c97-a00e-e9d1d1fe5804")
	)
	(text "196 kHz"
		(exclude_from_sim no)
		(at 167.64 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "84f8b64d-7445-4f2c-8f9f-178cd2ac6365")
	)
	(text "AP63356, 12V -> 5V, 450kHz fixed PWM (no light-load skipping)\n\nVout = 0.8V ref * (1 + R14/R16) = 0.8 * (1 + 68k/13k) = 4.985V (-0.3%)\n\nFeedforward cap C37: zero at 1/(2*pi*68k*100pF) = 23kHz\n  (datasheet ref 157k/47pF = 22kHz, matched)\n\nInductor L4 = 6.8uH (datasheet Table 1 value, do not change, internal comp)\nRipple current: dIL = 5 * (1 - 5/12) / (6.8u * 450k) = 0.95A peak-peak\ninductor peak = load + half ripple = 0.15 + 0.48 = ~0.6A\n\nOutput ripple: 0.95A / (8 * 450k * 30uF effective) = ~9mV peak-peak\n(30uF = 2x22uF derated for DC bias)\n\nLoad: 3x STDRIVEG600 + 18x EPC2304 gates ~50-150mA + REF3033, always CCM"
		(exclude_from_sim no)
		(at 27.94 125.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9875284c-7622-4b2c-9382-507123c0765c")
	)
	(text "D2 Leg 1 is NC so we can use \nthat to help with layout\n"
		(exclude_from_sim no)
		(at 261.62 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d2acbc84-e04b-4901-912c-5b6d3aaeee8a")
	)
	(text "1.599V ~ 48%"
		(exclude_from_sim no)
		(at 159.385 107.315 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e8c7f3c3-409a-41d9-a22d-96a99a957e15")
	)
	(text "Soft start 10000 cycles\nC20 = (1/200kHz) * 10000cycles / 4.7kOhm (R23) = 10006nF\nanything works between 1u-10u"
		(exclude_from_sim no)
		(at 163.83 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ee8b26ad-20c2-4d98-b972-966214db4055")
	)
